# Telegram Bot Token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# API Key для внешнего API polza.ai
OPENAI_API_KEY=your_polza_ai_api_key_here

# Внешний API URL
EXTERNAL_API_URL=https://polza.ai/api/v1
EXTERNAL_API_MODEL=z-ai/glm-5.3-flash

# Браузерный TLS для подключения к видеосервисам. none отключает имитацию.
VIDEO_IMPERSONATE=chrome

# Необязательно: адрес вашего HTTP/SOCKS-прокси с доступом к видеосервисам.
# Укажите реальный порт прокси из настроек вашего VPN-клиента.
# VIDEO_PROXY=http://127.0.0.1:PORT
# VIDEO_PROXY=socks5://127.0.0.1:PORT
